---
import Layout from "../layouts/Layout.astro";
import { business } from "../data/business.js";

const title = "About TRL | Firefighter-Owned Pressure Washing in Middle Tennessee";
const description =
  "Meet Mikey Hobbs, the local firefighter behind TRL Soft Pressure Wash. Learn why the Thin Red Line commitment to trust, discipline, and community drives every job.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "@id": `${business.siteUrl}/about-trl`,
  url: `${business.siteUrl}/about-trl`,
  name: title,
  description,
  mainEntity: {
    "@type": "Person",
    name: business.ownerName,
    jobTitle: "Owner / Firefighter",
    worksFor: { "@type": "Organization", name: business.name },
  },
};
---
<Layout title={title} description={description} path="/about-trl" jsonLd={jsonLd}>
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6 grid gap-14 lg:grid-cols-2 items-center">
      <div class="reveal">
        <span class="text-xs font-bold tracking-[0.2em] uppercase text-red-600">About TRL</span>
        <h1 class="mt-3 text-4xl font-black uppercase leading-tight sm:text-5xl">Meet Mikey Hobbs</h1>
        <p class="mt-6 text-neutral-600 text-lg leading-relaxed">
          I'm a local firefighter serving Middle Tennessee and the owner of TRL Soft Pressure Wash. When I'm not on
          duty protecting our community, I take the same dedication and discipline and apply it to helping
          homeowners keep their properties clean, safe, and protected.
        </p>
        <p class="mt-4 text-neutral-600 text-lg leading-relaxed">
          TRL stands for Thin Red Line, representing the commitment firefighters make to protect their communities.
          That same commitment drives how we treat every home we service, with professionalism, care, and
          attention to detail.
        </p>
        <a href="/estimate" class="inline-flex items-center gap-2 mt-8 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm bg-red-600 border-red-600 text-white hover:bg-transparent hover:text-red-600">
          Get a Free Quote
        </a>
      </div>
      <div class="reveal">
        <img src="/images/about/mikehobbs.jpg" alt="Mikey Hobbs, firefighter and owner of TRL Soft Pressure Wash" class="w-full h-[520px] object-cover object-top border border-black/10 shadow-sm" />
      </div>
    </div>
  </section>

  <section class="py-24 bg-neutral-50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid gap-8 sm:grid-cols-3">
        <div class="border-l-2 border-red-600 pl-5 reveal">
          <h3 class="font-extrabold uppercase text-lg mb-2">Trust &amp; Integrity</h3>
          <p class="text-neutral-500">As a firefighter, trust is everything. We treat every home with the same care and respect we would our own.</p>
        </div>
        <div class="border-l-2 border-red-600 pl-5 reveal">
          <h3 class="font-extrabold uppercase text-lg mb-2">Firefighter Discipline</h3>
          <p class="text-neutral-500">Attention to detail and professionalism guide every job we take on, from house washing to driveway cleaning.</p>
        </div>
        <div class="border-l-2 border-red-600 pl-5 reveal">
          <h3 class="font-extrabold uppercase text-lg mb-2">Serving Our Community</h3>
          <p class="text-neutral-500">We're proud to serve homeowners across Middle Tennessee and help keep our community looking its best.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-black text-white text-center py-24 px-6">
    <h2 class="text-4xl font-black uppercase sm:text-5xl mb-5">Proudly Serving Middle Tennessee</h2>
    <p class="text-neutral-300 max-w-2xl mx-auto mb-8 text-lg">
      Based locally and firefighter owned, TRL Soft Pressure Wash proudly serves homeowners throughout Middle
      Tennessee with professional exterior cleaning services including house washing, driveway cleaning, roof soft
      washing, deck restoration, and gutter cleaning.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/estimate" class="inline-flex items-center gap-2 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm bg-red-600 border-red-600 text-white hover:bg-transparent">Get a Free Quote</a>
      <a href={business.phoneHref} class="inline-flex items-center gap-2 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm border-white text-white hover:bg-white hover:text-black">Call {business.phoneDisplay}</a>
    </div>
  </section>
</Layout>
