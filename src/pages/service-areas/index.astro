---
import Layout from "../../layouts/Layout.astro";
import Faq from "../../components/Faq.astro";
import ServiceAreaMap from "../../components/ServiceAreaMap.astro";
import { business, serviceAreas } from "../../data/business.js";

const title = "Areas We Service | TRL Soft Pressure Washing | Middle Tennessee";
const description =
  "TRL Soft Pressure Washing serves Hohenwald and Middle Tennessee communities out to Smyrna, including Columbia, Spring Hill, Franklin, Murfreesboro, and more. See our full service area.";

const faqs = [
  {
    q: "How far will you travel for a job?",
    a: "We're based in Hohenwald and regularly work as far out as Smyrna and Murfreesboro. If your town isn't listed here, reach out anyway, there's a good chance you're still within range.",
  },
  {
    q: "Is there a travel fee for areas farther from Hohenwald?",
    a: "For most of the communities listed on this page, no. For properties well outside our normal service area, we'll let you know upfront before scheduling anything, no surprises on the invoice.",
  },
  {
    q: "Do you serve rural and acreage properties, not just subdivisions?",
    a: "Yes. A good portion of our work is rural homes, farms, and acreage properties between towns, not just subdivisions inside city limits.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "TRL Soft Pressure Washing Service Areas",
    itemListElement: serviceAreas.map((a, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: `${a.city}, ${a.state}`,
      url: `${business.siteUrl}/service-areas/${a.slug}`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: business.siteUrl + "/" },
      { "@type": "ListItem", position: 2, name: "Service Areas", item: `${business.siteUrl}/service-areas` },
    ],
  },
];
---
<Layout title={title} description={description} path="/service-areas" jsonLd={jsonLd}>
  <nav class="max-w-6xl mx-auto px-6 pt-8 text-sm text-neutral-500">
    <a href="/" class="hover:text-red-600">Home</a> <span class="mx-1">/</span> <span class="text-black font-semibold">Service Areas</span>
  </nav>

  <section class="py-14 bg-white">
    <div class="max-w-4xl mx-auto px-6 text-center reveal">
      <span class="text-xs font-bold tracking-[0.2em] uppercase text-red-600">Middle Tennessee</span>
      <h1 class="mt-3 text-4xl font-black uppercase leading-tight sm:text-5xl">Areas We Service</h1>
      <p class="mt-6 text-neutral-600 text-lg leading-relaxed">
        We're based in Hohenwald and run jobs across {serviceAreas.length} communities stretching out toward Smyrna and Murfreesboro, covering both the small towns along the way and the rural properties between them.
      </p>
    </div>
  </section>

  <ServiceAreaMap
    badgeOverride="Coverage Map"
    headingOverride="From Hohenwald to"
    headingAccentOverride="Smyrna"
    subtitleOverride={`Hover a county or a city below to see how they connect. ${business.name} is based in ${business.addressLocality} and runs jobs across ${serviceAreas.length} communities in ${[...new Set(serviceAreas.flatMap((a) => a.countyIds))].length} counties.`}
  />

  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-10 reveal">
        <span class="text-xs font-bold tracking-[0.2em] uppercase text-red-600">Full Directory</span>
        <h2 class="mt-3 text-3xl font-black uppercase leading-tight sm:text-4xl">Every Town We Serve</h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {serviceAreas.map((a) => (
          <a href={`/service-areas/${a.slug}`} class="block bg-neutral-50 border border-black/10 hover:border-red-600 p-6 transition reveal">
            <span class="block font-extrabold uppercase text-lg mb-1">{a.city}, {a.state}</span>
            <span class="block text-sm text-neutral-500">{(a.countyIds || []).join(" & ")} County{(a.countyIds || []).length > 1 ? "ies" : ""}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-neutral-50">
    <div class="max-w-3xl mx-auto px-6">
      <div class="mb-10 reveal">
        <span class="text-xs font-bold tracking-[0.2em] uppercase text-red-600">Frequently Asked Questions</span>
        <h2 class="mt-3 text-3xl font-black uppercase leading-tight sm:text-4xl">Service Area Questions</h2>
      </div>
      <Faq faqs={faqs} />
    </div>
  </section>

  <section class="bg-black text-white text-center py-24 px-6">
    <h2 class="text-4xl font-black uppercase sm:text-5xl mb-5">Don't See Your Town?</h2>
    <p class="text-neutral-300 max-w-2xl mx-auto mb-8 text-lg">Reach out anyway, we cover plenty of ground between these listed communities.</p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/estimate" class="inline-flex items-center gap-2 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm bg-red-600 border-red-600 text-white hover:bg-transparent">Get a Free Quote</a>
      <a href={business.phoneHref} class="inline-flex items-center gap-2 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm border-white text-white hover:bg-white hover:text-black">Call {business.phoneDisplay}</a>
    </div>
  </section>
</Layout>
