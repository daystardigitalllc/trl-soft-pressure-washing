---
import Layout from "../../layouts/Layout.astro";
import ServiceAreaLanding from "../../components/ServiceAreaLanding.astro";
import { business, nearbyServiceAreas } from "../../data/business.js";

const title = "Pressure Washing Spring Hill TN | TRL Soft Pressure Washing";
const description =
  "Top rated pressure washing for Spring Hill, TN homes, new subdivisions and rural properties alike. Licensed, insured, firefighter owned.";

const faqs = [
  {
    q: "Do new homes near GM Ultium Cells still need pressure washing?",
    a: "Yes. Even brand-new construction near the Ultium plant and surrounding subdivisions picks up builder dust, mud splash, and early algae film within the first year or two, well before it's visibly dirty.",
  },
  {
    q: "Spring Hill straddles two counties, does that change how you service it?",
    a: "No. We treat Spring Hill as one service area regardless of whether a property falls on the Maury County or Williamson County side of town.",
  },
  {
    q: "Do you clean rural properties outside the newer subdivisions?",
    a: "Yes, we still regularly work rural and older properties around Spring Hill, not just the newer neighborhoods that have grown up around town in recent years.",
  },
  {
    q: "How often do Spring Hill driveways need cleaning given all the construction traffic?",
    a: "Homes near active construction or new subdivisions often need driveway cleaning more often than typical, since red clay and dust from nearby building sites track in faster than normal wear.",
  },
  {
    q: "How do I get a pressure washing quote in Spring Hill?",
    a: "Quotes are free. Call or text (931) 213-0234, or fill out the quote form on this site, and we'll assess your property and recommend exactly what it needs.",
  },
  {
    q: "What's the difference between soft washing and pressure washing?",
    a: "Soft washing uses low pressure and a specialized cleaning solution to kill algae, mold, and mildew on siding, stucco, brick, and trim without damaging them. Concrete such as driveways and walkways is cleaned with surface-cleaning equipment instead.",
  },
  {
    q: "Will you protect my landscaping while you wash my house?",
    a: "Yes. We pre-wet landscaping and protect outlets and other delicate areas before applying any cleaning solution.",
  },
  {
    q: "How often should I have my Spring Hill house washed?",
    a: "Most homes do well every 12 to 18 months. Homes with heavy shade, nearby trees, or high humidity may need it more often to keep algae and mold from building up.",
  },
];

const extraSections = [
  {
    eyebrow: "Our Process",
    title: "How We Wash Spring Hill Homes",
    paragraphs: [
      "We start by inspecting your siding, trim, and exterior surfaces. Landscaping, outlets, and delicate areas are pre-wet and protected before we begin. We then apply a soft wash solution at low pressure to break down algae, mold, and grime, and finish with a controlled low-pressure rinse and a final inspection so the siding looks evenly clean.",
    ],
  },
  {
    eyebrow: "Right Method, Right Surface",
    title: "Matching the Method to the Surface",
    items: [
      { title: "Siding, Stucco, Brick & Trim", desc: "Low-pressure soft wash, not wand-blasting, so surfaces are cleaned without damage." },
      { title: "Driveways, Walkways & Patios", desc: "Surface cleaning for concrete, which helps with the red clay and builder dust that tracks in from nearby construction." },
      { title: "Roofs", desc: "Non-pressure soft wash for shingles, tile, and metal roofs." },
      { title: "Wood Decks & Fences", desc: "Wood-safe cleaning to remove gray oxidation and mildew." },
    ],
  },
  {
    eyebrow: "Commercial",
    title: "Spring Hill Businesses and HOAs",
    paragraphs: [
      "We also clean storefronts, parking lots, dumpster pads, awnings, and HOA entrances and sidewalks. We start with a free walkthrough and give you a written price before any work is scheduled, and jobs can be timed early morning, evening, or off-hours around your business.",
    ],
    links: [{ label: "Commercial Pressure Washing", href: "/commercial" }],
  },
  {
    eyebrow: "Free Estimate",
    title: "Your Free Spring Hill Estimate",
    paragraphs: [
      "Call or text (931) 213-0234, or use the quote form. We assess your property and recommend what it needs, at no charge. We're based in Hohenwald and serve Spring Hill and the rest of Middle Tennessee.",
    ],
    links: [
      { label: "Request a Free Quote", href: "/estimate" },
      { label: `Call ${business.phoneDisplay}`, href: business.phoneHref },
    ],
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Pressure Washing Spring Hill, TN",
    serviceType: "Pressure Washing",
    provider: { "@type": "HomeAndConstructionBusiness", name: business.name, telephone: business.phone, url: business.siteUrl },
    areaServed: { "@type": "City", name: "Spring Hill", containedInPlace: { "@type": "State", name: "Tennessee" } },
    url: `${business.siteUrl}/service-areas/spring-hill-tn`,
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: business.siteUrl + "/" },
      { "@type": "ListItem", position: 2, name: "Spring Hill, TN", item: `${business.siteUrl}/service-areas/spring-hill-tn` },
    ],
  },
];
---
<Layout title={title} description={description} path="/service-areas/spring-hill-tn" jsonLd={jsonLd}>
  <ServiceAreaLanding
    city="Spring Hill"
    state="TN"
    citySlug="spring-hill-tn"
    heading="Top Rated Pressure Washing in Spring Hill, TN"
    intro="Spring Hill continues to grow rapidly, and keeping homes looking their best is important for property value. Our professional pressure washing services remove dirt, algae, and buildup safely."
    intro2="Whether you live in a newer subdivision or a rural property outside town, our equipment handles everything from delicate siding to large concrete surfaces."
    offerings={[
      { title: "House Washing", desc: "Soft washing designed to protect siding while removing algae and grime." },
      { title: "Driveway Cleaning", desc: "High-powered surface cleaning for concrete driveways and walkways." },
      { title: "Patio & Pool Deck Cleaning", desc: "Restore outdoor living spaces safely and effectively." },
    ]}
    servingTitle="Serving Spring Hill Neighborhoods"
    neighborhoods={[
      "Cherry Grove, Campbell Station, and Autumn Ridge",
      "Neighborhoods near GM Ultium Cells",
      "Homes along Port Royal Road and Kedron Road",
      "Spring Hill communities across Maury and Williamson Counties",
    ]}
    faqs={faqs}
    extraSections={extraSections}
    nearby={nearbyServiceAreas("spring-hill-tn")}
  />
</Layout>
