---
import Layout from "../../layouts/Layout.astro";
import ServiceAreaLanding from "../../components/ServiceAreaLanding.astro";
import { business, homeFaqs, nearbyServiceAreas } from "../../data/business.js";

const title = "Pressure Washing Murfreesboro TN | TRL Soft Pressure Washing";
const description =
  "Reliable soft wash and pressure washing for homes and multi-family properties in Murfreesboro, TN. Licensed, insured, firefighter owned.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Pressure Washing Murfreesboro, TN",
    serviceType: "Pressure Washing",
    provider: { "@type": "HomeAndConstructionBusiness", name: business.name, telephone: business.phone, url: business.siteUrl },
    areaServed: { "@type": "City", name: "Murfreesboro", containedInPlace: { "@type": "State", name: "Tennessee" } },
    url: `${business.siteUrl}/service-areas/murfreesboro-tn`,
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: business.siteUrl + "/" },
      { "@type": "ListItem", position: 2, name: "Murfreesboro, TN", item: `${business.siteUrl}/service-areas/murfreesboro-tn` },
    ],
  },
];
---
<Layout title={title} description={description} path="/service-areas/murfreesboro-tn" jsonLd={jsonLd}>
  <ServiceAreaLanding
    city="Murfreesboro"
    state="TN"
    heading="Reliable Pressure Washing in Murfreesboro, TN"
    intro="Murfreesboro is one of the fastest-growing cities in the country, and with growth comes dust, traffic grime, and construction debris. We help Murfreesboro homeowners maintain their property value with elite exterior cleaning that stands out in Rutherford County."
    intro2="Whether you're a homeowner in Blackman, a property manager near MTSU, or have a historic home near the Square, we bring the professional equipment needed to handle Murfreesboro's largest cleaning jobs efficiently."
    offerings={[
      { title: "Multi-Family & Student Housing", desc: "Large-scale building washing for apartments and townhome complexes." },
      { title: "Concrete Sealing & Cleaning", desc: "Protecting your driveway from Murfreesboro's temperature swings and heavy use." },
      { title: "Roof Algae Removal", desc: "Safe soft washing for roofs to improve energy efficiency and curb appeal." },
    ]}
    servingTitle="Serving Rutherford County"
    neighborhoods={[
      "Blackman, Marymont Springs, and Siegel areas",
      "Northwoods, Indian Hills, and Riverscut",
      "Neighborhoods near MTSU and the VA Hospital",
      "The Gateway and downtown Murfreesboro districts",
    ]}
    faqs={homeFaqs}
    nearby={nearbyServiceAreas("murfreesboro-tn")}
  />
</Layout>
