---
import Layout from "../layouts/Layout.astro";
import Faq from "../components/Faq.astro";
import { business } from "../data/business.js";

const title = "Commercial Pressure Washing Services | Middle Tennessee | TRL";
const description =
  "Reliable commercial exterior cleaning across Middle Tennessee: dumpster pads, HOA communities, storefronts, parking lots, awnings, and scheduled maintenance plans.";

const faqs = [
  { q: "Can you clean after hours so it doesn't disrupt my business?", a: "Yes. We schedule early morning, evening, and off-hour jobs for storefronts, parking lots, and dumpster pads so customers and staff are never in the way." },
  { q: "How often should a commercial property be pressure washed?", a: "Dumpster pads and high-traffic entrances usually need monthly or quarterly cleaning, while building exteriors and parking lots typically do well once or twice a year. We'll recommend a schedule after seeing the property." },
  { q: "Do you work with HOAs and property managers on multiple properties?", a: "Yes. We regularly handle community entrances, pool decks, and sidewalks for HOAs, and we can bundle several properties under one recurring plan." },
  { q: "Are you insured to work on commercial properties?", a: "Yes. TRL is licensed and carries liability insurance, and we can provide proof of coverage to property managers on request." },
  { q: "Which towns do you serve for commercial pressure washing?", a: "We serve businesses from Hohenwald out to Smyrna, including Columbia, Spring Hill, Franklin, Murfreesboro, and Dickson. See the full list on our service areas page." },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    serviceType: "Commercial Pressure Washing",
    provider: { "@type": "HomeAndConstructionBusiness", name: business.name, telephone: business.phone, url: business.siteUrl },
    areaServed: business.areaServed,
    url: `${business.siteUrl}/commercial`,
    description,
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];

const offerings = [
  { title: "Dumpster Pad Cleaning", desc: "Dumpster areas collect grease, food waste, bacteria, and foul odors. Our high-pressure cleaning removes buildup, eliminates smells, and restores sanitation around your property." },
  { title: "HOA Community Cleaning", desc: "We work with HOA boards and property managers to maintain sidewalks, pool decks, entryways, and community spaces, helping neighborhoods stay clean and welcoming." },
  { title: "Storefront Cleaning", desc: "Your storefront is the first thing customers see. We remove gum, dirt, algae, and grime from sidewalks, entrances, and building fronts so your business looks professional." },
  { title: "Parking Lot Cleaning", desc: "Oil stains, tire marks, and debris build up quickly in parking lots. Our commercial equipment removes buildup to keep your property clean, safe, and attractive." },
  { title: "Awning Cleaning", desc: "Fabric and vinyl awnings collect mold, dirt, and pollution stains. Our soft washing method safely restores their appearance without damaging the material." },
  { title: "Scheduled Maintenance Plans", desc: "Many commercial clients choose routine cleaning schedules to keep their property looking its best year-round. Monthly, quarterly, and annual service plans are available." },
];
---
<Layout title={title} description={description} path="/commercial" jsonLd={jsonLd}>
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6 text-center reveal">
      <span class="text-xs font-bold tracking-[0.2em] uppercase text-red-600">Commercial Pressure Washing</span>
      <h1 class="mt-3 text-4xl font-black uppercase leading-tight sm:text-5xl">Professional Cleaning for Businesses &amp; Properties</h1>
      <p class="mt-6 text-neutral-600 text-lg leading-relaxed">
        TRL Soft Pressure Wash provides reliable commercial exterior cleaning services throughout Middle Tennessee.
        From dumpster pads and storefronts to HOA communities and parking lots, we help businesses maintain a clean,
        safe, and professional appearance.
      </p>
      <a href="/estimate" class="inline-flex items-center gap-2 mt-8 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm bg-red-600 border-red-600 text-white hover:bg-transparent hover:text-red-600">
        Request Commercial Quote
      </a>
    </div>
  </section>

  <section class="py-24 bg-neutral-50">
    <div class="max-w-7xl mx-auto px-6">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {offerings.map((o) => (
          <div class="bg-white border border-black/10 border-t-4 border-t-red-600 p-6 reveal">
            <h3 class="font-extrabold uppercase text-lg mb-2">{o.title}</h3>
            <p class="text-neutral-500 text-sm leading-relaxed">{o.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-24 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-xl mb-14 reveal">
        <span class="text-xs font-bold tracking-[0.2em] uppercase text-red-600">Why Businesses Choose TRL</span>
      </div>
      <div class="grid gap-8 sm:grid-cols-3">
        <div class="border-l-2 border-red-600 pl-5 reveal">
          <h3 class="font-extrabold uppercase text-lg mb-2">Licensed &amp; Insured</h3>
          <p class="text-neutral-500">Commercial properties require professionalism and protection. TRL Soft Pressure Wash is fully insured for peace of mind.</p>
        </div>
        <div class="border-l-2 border-red-600 pl-5 reveal">
          <h3 class="font-extrabold uppercase text-lg mb-2">Flexible Scheduling</h3>
          <p class="text-neutral-500">We work around your business hours with early morning, evening, or off-hour service to minimize disruption.</p>
        </div>
        <div class="border-l-2 border-red-600 pl-5 reveal">
          <h3 class="font-extrabold uppercase text-lg mb-2">Local &amp; Reliable</h3>
          <p class="text-neutral-500">Firefighter owned and locally operated, we take pride in delivering dependable service to businesses across Middle Tennessee.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-neutral-50">
    <div class="max-w-4xl mx-auto px-6 reveal">
      <span class="text-xs font-bold tracking-[0.2em] uppercase text-red-600">How It Works</span>
      <h2 class="mt-3 text-3xl font-black uppercase leading-tight sm:text-4xl">Commercial Cleaning Without the Disruption</h2>
      <p class="mt-5 text-neutral-600 text-lg leading-relaxed">
        We start with a free walkthrough of your property, note the surfaces that need attention (dumpster pads, entrances, parking
        areas, awnings), and give you a written price before any work is scheduled. Jobs are timed around your hours, and we protect
        landscaping and drains so runoff stays under control.
      </p>
      <p class="mt-4 text-neutral-600 text-lg leading-relaxed">
        Most of our commercial work is in small-town and suburban Tennessee: downtown storefronts in
        <a href="/service-areas/columbia-tn" class="underline underline-offset-2 hover:text-red-600">Columbia</a>, strip centers and
        offices around <a href="/service-areas/franklin-tn" class="underline underline-offset-2 hover:text-red-600">Franklin</a>, and
        apartment and rental properties near MTSU in
        <a href="/service-areas/murfreesboro-tn" class="underline underline-offset-2 hover:text-red-600">Murfreesboro</a>.
        We're a Hohenwald-based <a href="/" class="underline underline-offset-2 hover:text-red-600">pressure washing</a> company, so
        local routes stay efficient. See every town on our <a href="/service-areas" class="underline underline-offset-2 hover:text-red-600">service areas page</a>.
      </p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-6">
      <div class="mb-10 reveal">
        <span class="text-xs font-bold tracking-[0.2em] uppercase text-red-600">Common Questions</span>
        <h2 class="mt-3 text-3xl font-black uppercase leading-tight">Commercial Pressure Washing FAQs</h2>
      </div>
      <Faq faqs={faqs} />
    </div>
  </section>

  <section class="bg-black text-white text-center py-24 px-6">
    <h2 class="text-4xl font-black uppercase sm:text-5xl mb-5">Keep Your Property Looking Professional</h2>
    <p class="text-neutral-300 max-w-2xl mx-auto mb-8 text-lg">
      From dumpster pads and storefronts to parking lots and HOA communities, TRL Soft Pressure Wash helps
      businesses maintain clean, safe, and welcoming properties.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/estimate" class="inline-flex items-center gap-2 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm bg-red-600 border-red-600 text-white hover:bg-transparent">Request Commercial Quote</a>
      <a href={business.phoneHref} class="inline-flex items-center gap-2 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm border-white text-white hover:bg-white hover:text-black">Call {business.phoneDisplay}</a>
    </div>
    <p class="mt-6 text-neutral-400 text-sm uppercase tracking-widest">Serving businesses throughout Middle Tennessee</p>
  </section>
</Layout>
