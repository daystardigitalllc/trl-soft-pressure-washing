---
import Layout from "../layouts/Layout.astro";
import EstimateForm from "../components/EstimateForm.astro";
import { business } from "../data/business.js";

const title = "Free Instant Estimate | TRL Soft Pressure Washing";
const description =
  "Get an instant, no-obligation price range for house washing, roof cleaning, concrete cleaning, or deck & fence washing in Middle Tennessee. No sales calls required.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: "Pressure Washing Estimate",
  provider: { "@type": "HomeAndConstructionBusiness", name: business.name, telephone: business.phone, url: business.siteUrl },
  areaServed: business.areaServed,
  url: `${business.siteUrl}/estimate`,
  description,
};
---
<Layout title={title} description={description} path="/estimate" jsonLd={jsonLd}>
  <section class="py-20 bg-black text-white">
    <div class="max-w-4xl mx-auto px-6 text-center reveal">
      <span class="inline-flex items-center gap-2 px-4 py-2 mb-5 text-xs font-bold tracking-[0.22em] uppercase border rounded-lg bg-red-600/15 border-red-500/50 text-white">Instant &amp; Free</span>
      <h1 class="font-black uppercase leading-tight text-[clamp(2.2rem,5vw,3.6rem)]">Get Your Price Range in 30 Seconds</h1>
      <p class="mt-6 text-neutral-300 text-lg leading-relaxed max-w-2xl mx-auto">
        Tell us what needs cleaned and roughly how many square feet, and we'll give you an instant high/low estimate —
        no sales call, no pressure. We'll confirm your exact price with a free on-site walkthrough before any work begins.
      </p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6 grid gap-14 lg:grid-cols-[1fr_1.1fr] items-start">
      <div class="reveal">
        <span class="text-xs font-bold tracking-[0.2em] uppercase text-red-600">How It Works</span>
        <h2 class="mt-3 text-3xl font-black uppercase leading-tight sm:text-4xl">Three Quick Steps</h2>
        <ul class="mt-8 space-y-6">
          <li class="border-l-2 border-red-600 pl-5">
            <h3 class="font-extrabold uppercase text-lg mb-1">1. Tell Us What You Need</h3>
            <p class="text-neutral-500">Pick the surface — house wash, roof, concrete, or deck/fence — and enter your best guess at the square footage.</p>
          </li>
          <li class="border-l-2 border-red-600 pl-5">
            <h3 class="font-extrabold uppercase text-lg mb-1">2. Get Your Instant Range</h3>
            <p class="text-neutral-500">We'll show you a real high/low price range immediately, based on the typical cost of jobs that size.</p>
          </li>
          <li class="border-l-2 border-red-600 pl-5">
            <h3 class="font-extrabold uppercase text-lg mb-1">3. We Confirm On-Site — Free</h3>
            <p class="text-neutral-500">Before any work is scheduled, we'll walk the property and lock in an exact, no-surprise price. Never any obligation.</p>
          </li>
        </ul>
        <p class="mt-8 text-sm text-neutral-400">Don't know your square footage? Just give us your best guess — we'll fine-tune it on the walkthrough.</p>
      </div>

      <div class="reveal">
        <EstimateForm />
      </div>
    </div>
  </section>
</Layout>
