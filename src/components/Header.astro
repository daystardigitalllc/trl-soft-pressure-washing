---
import { business, mainNav } from "../data/business.js";

export interface Props {
  dark?: boolean;
}
const { dark = false } = Astro.props as Props;
---
<header class:list={["site-header fixed top-0 left-0 w-full z-50 transition-all duration-300 py-3 sm:py-5", dark && "site-header--dark"]} id="siteHeader">
  <div class="max-w-[1280px] mx-auto px-6 flex items-center justify-between">
    <a href="/" class="flex items-center gap-3 group">
      <img alt="TRL Soft Pressure Wash" class="h-10 sm:h-14 w-auto shrink-0" src={business.logo} width="56" height="56" />
      <div class="flex flex-col leading-none min-w-0">
        <span class="hdr-brand-text uppercase tracking-wide font-black text-[0.9rem] sm:text-[1rem] whitespace-nowrap">
          <span class="text-red-600">TRL</span> <span class="hidden sm:inline">Soft Pressure Washing</span><span class="sm:hidden">Soft Wash</span>
        </span>
        <span class="hdr-tagline hidden sm:block uppercase text-[0.6rem] tracking-[0.2em] mt-[2px] whitespace-nowrap">Thin Red Line · Firefighter Owned</span>
      </div>
    </a>

    <nav class="hidden xl:flex items-center gap-0.5 ml-8" aria-label="Primary">
      {mainNav.map((item) => (
        <a href={item.href} class="hdr-nav-link relative whitespace-nowrap px-2.5 py-1.5 rounded hover:text-red-600 transition group uppercase tracking-[0.05em] text-[0.82rem] font-semibold">
          {item.label}
          <span class="absolute bottom-0 left-2.5 right-2.5 h-[2px] bg-red-600 origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-200"></span>
        </a>
      ))}
      <a href="/estimate" class="ml-4 inline-flex items-center gap-2 whitespace-nowrap px-5 py-2.5 rounded text-white font-bold uppercase tracking-[0.08em] text-[0.82rem] bg-red-600 border-2 border-red-600 transition hover:bg-transparent hover:text-red-600 hover:-translate-y-[1px]">
        Request a Quote
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M7 7h10v10"></path></svg>
      </a>
    </nav>

    <button class="xl:hidden flex flex-col gap-[5px] z-[101]" id="hamburgerBtn" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobileNav">
      <span class="hdr-hamburger-bar block w-6 h-[2px] transition"></span>
      <span class="hdr-hamburger-bar block w-6 h-[2px] transition"></span>
      <span class="hdr-hamburger-bar block w-6 h-[2px] transition"></span>
    </button>
  </div>

  <nav class="xl:hidden hidden flex flex-col gap-1 bg-white border-t border-black/10 px-6 py-4 mt-5" id="mobileNav" aria-label="Mobile">
    {mainNav.map((item) => (
      <a href={item.href} class="py-3 uppercase tracking-[0.08em] text-sm font-semibold text-black border-b border-black/10">{item.label}</a>
    ))}
    <a href={business.phoneHref} class="py-3 uppercase tracking-[0.08em] text-sm font-semibold text-black border-b border-black/10">{business.phoneDisplay}</a>
    <a href="/estimate" class="mt-3 inline-flex items-center justify-center gap-2 px-6 py-3 rounded text-white font-bold uppercase tracking-[0.1em] bg-red-600">Request a Quote</a>
  </nav>
</header>
<div class="h-24" aria-hidden="true"></div>

<script>
  const header = document.getElementById("siteHeader");
  const btn = document.getElementById("hamburgerBtn");
  const nav = document.getElementById("mobileNav");

  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 12) header.classList.add("is-scrolled");
    else header.classList.remove("is-scrolled");
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  btn?.addEventListener("click", () => {
    const isOpen = nav?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(isOpen));
  });
</script>
