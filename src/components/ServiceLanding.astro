---
import Faq from "./Faq.astro";
import BeforeAfter from "./BeforeAfter.astro";
import { business } from "../data/business.js";

export interface Props {
  eyebrow: string;
  heroTitle: string;
  heroDesc: string;
  beforeAfter: { before: string; after: string; title: string; place: string; desc: string };
  whyEyebrow: string;
  whyTitle: string;
  whyIntro: string;
  painPoints: { title: string; desc: string }[];
  processSteps: { title: string; desc: string }[];
  faqs: { q: string; a: string }[];
  closingTitle: string;
  closingDesc: string;
  footerNote?: string;
}

const {
  eyebrow,
  heroTitle,
  heroDesc,
  beforeAfter,
  whyEyebrow,
  whyTitle,
  whyIntro,
  painPoints,
  processSteps,
  faqs,
  closingTitle,
  closingDesc,
  footerNote,
} = Astro.props as Props;
---
<section class="py-20 bg-white">
  <div class="max-w-4xl mx-auto px-6 reveal">
    <span class="text-xs font-bold tracking-[0.2em] uppercase text-red-600">{eyebrow}</span>
    <h1 class="mt-3 text-4xl font-black uppercase leading-tight sm:text-5xl">{heroTitle}</h1>
    <p class="mt-6 text-neutral-600 text-lg leading-relaxed max-w-xl">{heroDesc}</p>
    <div class="flex flex-wrap gap-4 mt-8">
      <a href="/estimate" class="inline-flex items-center gap-2 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm bg-red-600 border-red-600 text-white hover:bg-transparent hover:text-red-600">Get My Free Quote</a>
      <a href={business.phoneHref} class="inline-flex items-center gap-2 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm border-black text-black hover:bg-black hover:text-white">Call Now</a>
    </div>
  </div>
</section>

<section class="pb-20 bg-white">
  <div class="max-w-3xl mx-auto px-6">
    <BeforeAfter {...beforeAfter} />
  </div>
</section>

<section class="py-24 bg-neutral-50">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mb-14 reveal">
      <span class="text-xs font-bold tracking-[0.2em] uppercase text-red-600">{whyEyebrow}</span>
      <h2 class="mt-3 text-3xl font-black uppercase leading-tight sm:text-4xl">{whyTitle}</h2>
      <p class="mt-4 text-neutral-500 text-lg">{whyIntro}</p>
    </div>
    <div class="grid gap-6 sm:grid-cols-3">
      {painPoints.map((p) => (
        <div class="bg-white border border-black/10 border-t-4 border-t-red-600 p-6 reveal">
          <h3 class="font-extrabold uppercase text-base mb-2">{p.title}</h3>
          <p class="text-neutral-500 text-sm leading-relaxed">{p.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="py-24 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="max-w-2xl mb-14 reveal">
      <span class="text-xs font-bold tracking-[0.2em] uppercase text-red-600">Standard Operating Procedure</span>
      <h2 class="mt-3 text-3xl font-black uppercase leading-tight sm:text-4xl">The TRL Process</h2>
    </div>
    <div class="grid gap-10 sm:grid-cols-3">
      {processSteps.map((s, i) => (
        <div class="reveal">
          <div class="text-5xl font-black text-red-600/30 mb-3">{String(i + 1).padStart(2, "0")}</div>
          <h3 class="font-extrabold uppercase text-lg mb-2">{s.title}</h3>
          <p class="text-neutral-500 leading-relaxed">{s.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="py-24 bg-neutral-50">
  <div class="max-w-3xl mx-auto px-6">
    <div class="mb-10 reveal">
      <span class="text-xs font-bold tracking-[0.2em] uppercase text-red-600">Common Questions</span>
    </div>
    <Faq faqs={faqs} />
  </div>
</section>

<section class="bg-black text-white text-center py-24 px-6">
  <h2 class="text-4xl font-black uppercase sm:text-5xl mb-5">{closingTitle}</h2>
  <p class="text-neutral-300 max-w-2xl mx-auto mb-8 text-lg">{closingDesc}</p>
  <div class="flex flex-wrap justify-center gap-4">
    <a href="/estimate" class="inline-flex items-center gap-2 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm bg-red-600 border-red-600 text-white hover:bg-transparent">Get My Free Quote</a>
    <a href={business.phoneHref} class="inline-flex items-center gap-2 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm border-white text-white hover:bg-white hover:text-black">Call {business.phoneDisplay}</a>
  </div>
  {footerNote && <p class="mt-8 text-neutral-500 text-xs max-w-3xl mx-auto uppercase tracking-wide leading-relaxed">{footerNote}</p>}
</section>
