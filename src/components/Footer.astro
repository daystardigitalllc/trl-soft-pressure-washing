---
import { business, services, serviceAreas } from "../data/business.js";
---
<footer class="relative bg-black text-white overflow-hidden">
  <div class="h-[10px] w-full bg-gradient-to-r from-red-600 via-red-800 to-transparent"></div>
  <div class="relative max-w-7xl mx-auto px-6 py-16">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href="/" class="flex items-center gap-3 mb-5 group">
          <img alt="TRL Soft-Pressure Washing logo" src={business.logo} class="h-12 w-auto" width="48" height="48" />
        </a>
        <p class="text-gray-400 text-sm max-w-xs mb-6">Licensed, insured, and firefighter owned. Serving Middle Tennessee with the same discipline we carry on the line.</p>
        <a href={business.phoneHref} class="text-xl font-bold hover:text-red-500 transition">{business.phoneDisplay.replace("(", "").replace(") ", "-")}</a>
        <div class="flex items-center gap-3 mt-5">
          <a href={business.facebook} target="_blank" rel="noopener noreferrer" class="w-10 h-10 flex items-center justify-center border border-white/20 hover:bg-red-600 hover:border-red-600 transition" aria-label="Facebook">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"></path></svg>
          </a>
          <a href={business.phoneHref} class="px-4 py-2 border border-red-600 text-red-600 uppercase text-xs font-semibold hover:bg-red-600 hover:text-white transition">Call Now</a>
        </div>
      </div>

      <div>
        <h4 class="uppercase text-xs tracking-widest font-semibold mb-4 flex items-center gap-2"><span class="w-5 h-[2px] bg-red-600"></span>Pages</h4>
        <ul class="space-y-2 text-gray-400">
          <li><a href="/about-trl" class="hover:text-white transition block py-1">About</a></li>
          <li><a href="/residential" class="hover:text-white transition block py-1">Residential</a></li>
          <li><a href="/commercial" class="hover:text-white transition block py-1">Commercial</a></li>
        </ul>
      </div>

      <div>
        <h4 class="uppercase text-xs tracking-widest font-semibold mb-4 flex items-center gap-2"><span class="w-5 h-[2px] bg-red-600"></span>Services</h4>
        <ul class="space-y-2 text-gray-400">
          {services.map((s) => (
            <li><a href={s.href ?? `/services/${s.slug}`} class="hover:text-white transition block py-1">{s.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="uppercase text-xs tracking-widest font-semibold mb-4 flex items-center gap-2"><span class="w-5 h-[2px] bg-red-600"></span><a href="/service-areas" class="hover:text-white transition">Service Area</a></h4>
        <ul class="space-y-2 text-gray-400 mb-8">
          {serviceAreas.map((a) => (
            <li><a href={`/service-areas/${a.slug}`} class="hover:text-white transition">{a.city}, {a.state}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-8 mt-8 border-t border-white/10 text-sm text-gray-500">
      <span>&copy; {new Date().getFullYear()} TRL Soft Pressure Wash</span>
      <span class="text-red-600 uppercase tracking-widest text-xs font-bold">Honoring the Thin Red Line</span>
    </div>
  </div>
</footer>
