---
export interface Props {
  before: string;
  after: string;
  badge?: string;
  title: string;
  place: string;
  desc: string;
}
const { before, after, badge, title, place, desc } = Astro.props as Props;
---
<div class="reveal bg-white border border-black/10 shadow-sm overflow-hidden">
  <div class="ba-slider">
    <span class="absolute right-3 top-3 z-[4] bg-red-600 text-white text-[0.65rem] font-bold uppercase tracking-[0.15em] px-2.5 py-1">After</span>
    <span class="absolute left-3 top-3 z-[4] bg-black/70 text-white text-[0.65rem] font-bold uppercase tracking-[0.15em] px-2.5 py-1">Before</span>
    <img class="ba-after" src={after} alt={`${title} after`} loading="lazy" />
    <div class="ba-before-wrap">
      <img src={before} alt={`${title} before`} loading="lazy" />
    </div>
    <div class="ba-handle"></div>
  </div>
  <div class="p-5">
    {badge && <span class="block text-[0.65rem] font-bold uppercase tracking-[0.15em] text-red-600 mb-1.5">{badge}</span>}
    <h3 class="font-extrabold uppercase text-[1.05rem] mb-1">{title}</h3>
    <p class="text-neutral-500 text-sm mb-2">{place}</p>
    <p class="text-neutral-500 text-sm">{desc}</p>
  </div>
</div>

<script>
  function initSliders() {
    document.querySelectorAll<HTMLElement>('.ba-slider').forEach((slider) => {
      if ((slider as any)._init) return;
      (slider as any)._init = true;
      const beforeWrap = slider.querySelector<HTMLElement>('.ba-before-wrap');
      const handle = slider.querySelector<HTMLElement>('.ba-handle');

      const setPos = (pct: number) => {
        const clamped = Math.min(100, Math.max(0, pct));
        if (beforeWrap) beforeWrap.style.clipPath = `inset(0 ${100 - clamped}% 0 0)`;
        if (handle) handle.style.left = clamped + '%';
      };
      setPos(50);

      let dragging = false;
      const move = (clientX: number) => {
        const rect = slider.getBoundingClientRect();
        const pct = ((clientX - rect.left) / rect.width) * 100;
        setPos(pct);
      };
      slider.addEventListener('mousedown', (e) => { dragging = true; move((e as MouseEvent).clientX); });
      window.addEventListener('mousemove', (e) => { if (dragging) move((e as MouseEvent).clientX); });
      window.addEventListener('mouseup', () => (dragging = false));
      slider.addEventListener('touchstart', (e) => move((e as TouchEvent).touches[0].clientX), { passive: true });
      slider.addEventListener('touchmove', (e) => move((e as TouchEvent).touches[0].clientX), { passive: true });
    });
  }
  document.addEventListener('DOMContentLoaded', initSliders);
  initSliders();
</script>
