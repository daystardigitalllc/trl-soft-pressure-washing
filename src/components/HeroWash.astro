---
import { business } from "../data/business.js";

export interface Props {
  before: string;
  after: string;
}
const { before, after } = Astro.props as Props;
---
<section class="hero-wash relative bg-black -mt-24">
  <div class="hero-wash__sticky sticky top-0 h-[78vh] overflow-hidden pt-24">
    <img class="absolute inset-0 w-full h-full object-cover" src={before} alt="House before cleaning" />
    <div class="hero-wash__after-wrap absolute top-0 left-0 w-full overflow-hidden" style="height: 0%;">
      <img class="absolute top-0 left-0 w-full h-[78vh] object-cover" src={after} alt="House after cleaning" />
    </div>
    <div class="absolute inset-0 lg:hidden bg-[linear-gradient(to_right,rgba(0,0,0,0.9)_0%,rgba(0,0,0,0.82)_55%,rgba(0,0,0,0.55)_78%,rgba(0,0,0,0.2)_92%,transparent_100%)]"></div>
    <div class="absolute inset-0 hidden lg:block bg-[linear-gradient(to_right,rgba(0,0,0,0.88)_0%,rgba(0,0,0,0.78)_26%,rgba(0,0,0,0.45)_42%,rgba(0,0,0,0.15)_58%,rgba(0,0,0,0.02)_72%,transparent_85%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(0,0,0,0.65)_0%,rgba(0,0,0,0.4)_20%,transparent_45%)]"></div>

    <div class="relative z-10 h-full w-full max-w-[1280px] mx-auto px-7 flex items-center">
      <div class="max-w-[580px] pb-16">
        <div class="inline-flex items-center gap-2 px-4 py-2 mb-5 text-xs font-bold tracking-[0.22em] uppercase border rounded-lg bg-red-600/15 border-red-500/50 text-white">Firefighter Owned &amp; Operated</div>
        <h1 class="mb-5 font-black uppercase leading-[0.9] tracking-tight">
          <span class="block text-[clamp(3rem,6.5vw,5.8rem)] text-red-500">Restore.</span>
          <span class="block text-[clamp(3rem,6.5vw,5.8rem)] text-white">Refresh.</span>
          <span class="block mt-2 text-[clamp(1.5rem,2.8vw,2.5rem)] font-semibold text-neutral-300">Soft Pressure Washing</span>
        </h1>
        <p class="max-w-[440px] mb-9 text-neutral-300 leading-relaxed">
          Residential &amp; commercial soft wash and pressure cleaning — safe, thorough, and built on the same commitment to service we carry on the line. Licensed. Insured. 100% satisfaction guaranteed.
        </p>
        <div class="flex flex-wrap items-center gap-4 mb-12">
          <a href={business.smsHref} class="inline-flex items-center gap-2 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm bg-red-600 border-red-600 text-white hover:bg-transparent hover:text-red-500 hover:-translate-y-0.5 shadow-lg shadow-red-600/30">
            Get a Free Quote
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M7 7h10v10"></path></svg>
          </a>
          <a href="#services" class="inline-flex items-center gap-2 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm border-white text-white hover:bg-white/15">
            Our Services ›
          </a>
        </div>
        <div class="flex items-center gap-3 text-sm font-semibold text-neutral-300">
          <span>Google Rating 5.0</span>
          <span class="text-red-500 tracking-[2px]">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        </div>
      </div>
    </div>

    <div class="hero-wash__fireman absolute bottom-0 right-0 w-[220px] sm:w-[320px] z-30" style="overflow: visible; transform: translateX(18%);">
      <img
        alt="Firefighter spraying a soft wash hose"
        class="w-full h-auto drop-shadow-[0_12px_20px_rgba(0,0,0,0.5)]"
        style="transform: scaleX(-1);"
        src="/images/firefighter-hose.png"
      />
      <svg class="hero-wash__stream absolute inset-0 z-10 pointer-events-none" style="overflow: visible;" viewBox="0 0 1000 650" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
        <path class="hero-wash__stream-path" d="M419 246 C 300 150, 180 30, 60 -90" fill="none" stroke="#eaf7ff" stroke-width="10" stroke-linecap="round" stroke-dasharray="8 24" opacity="0.9" />
        <path class="hero-wash__stream-path hero-wash__stream-path--2" d="M419 246 C 310 175, 210 80, 110 -30" fill="none" stroke="#c9ecff" stroke-width="8" stroke-linecap="round" stroke-dasharray="7 22" opacity="0.85" />
        <path class="hero-wash__stream-path hero-wash__stream-path--3" d="M419 246 C 320 195, 240 120, 165 20" fill="none" stroke="#eaf7ff" stroke-width="7" stroke-linecap="round" stroke-dasharray="6 20" opacity="0.8" />
        <path class="hero-wash__stream-path hero-wash__stream-path--4" d="M419 246 C 330 210, 265 155, 205 80" fill="none" stroke="#9fdcff" stroke-width="6" stroke-linecap="round" stroke-dasharray="5 18" opacity="0.7" />
      </svg>
    </div>
  </div>
</section>

<style>
  .hero-wash {
    height: 92vh;
  }
  .hero-wash__stream-path {
    animation: hero-stream-flow 0.5s linear infinite;
  }
  .hero-wash__stream-path--2 {
    animation-duration: 0.45s;
  }
  .hero-wash__stream-path--3 {
    animation-duration: 0.4s;
  }
  .hero-wash__stream-path--4 {
    animation-duration: 0.35s;
  }
  @keyframes hero-stream-flow {
    to {
      stroke-dashoffset: -64;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-wash__stream-path {
      animation: none;
    }
  }
</style>

<script>
  function initHeroWash() {
    const section = document.querySelector<HTMLElement>(".hero-wash");
    const sticky = document.querySelector<HTMLElement>(".hero-wash__sticky");
    const afterWrap = document.querySelector<HTMLElement>(".hero-wash__after-wrap");
    if (!section || !sticky || !afterWrap || section.dataset.init) return;
    section.dataset.init = "true";

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) {
      afterWrap.style.height = "100%";
      return;
    }

    let ticking = false;

    const update = () => {
      ticking = false;
      const rect = section.getBoundingClientRect();
      const total = rect.height - sticky.offsetHeight;
      const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;

      // House reveals from the top down as the visitor scrolls through the hero.
      const revealPct = Math.min(100, Math.max(0, progress * 100));
      afterWrap.style.height = `${revealPct}%`;
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  }
  document.addEventListener("DOMContentLoaded", initHeroWash);
  initHeroWash();
</script>
