---
import { business } from "../data/business.js";
import Marquee from "./Marquee.astro";

export interface Props {
  before: string;
  after: string;
}
const { before, after } = Astro.props as Props;
---
<section class="hero-wash relative bg-black -mt-24">
  <div class="hero-wash__sticky sticky top-0 h-[calc(100vh-46px)] overflow-hidden pt-24">
    <img class="absolute inset-0 w-full h-full object-cover" src={before} alt="House before cleaning" />
    <div class="hero-wash__after-wrap absolute top-0 left-0 w-full overflow-hidden" style="height: 0%;">
      <img class="absolute top-0 left-0 w-full h-[calc(100vh-46px)] object-cover" src={after} alt="House after cleaning" />
    </div>
    <div class="absolute inset-0 lg:hidden bg-[linear-gradient(to_right,rgba(0,0,0,0.9)_0%,rgba(0,0,0,0.82)_55%,rgba(0,0,0,0.55)_78%,rgba(0,0,0,0.2)_92%,transparent_100%)]"></div>
    <div class="absolute inset-0 hidden lg:block bg-[linear-gradient(to_right,rgba(0,0,0,0.88)_0%,rgba(0,0,0,0.78)_26%,rgba(0,0,0,0.45)_42%,rgba(0,0,0,0.15)_58%,rgba(0,0,0,0.02)_72%,transparent_85%)]"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_top,rgba(0,0,0,0.65)_0%,rgba(0,0,0,0.4)_20%,transparent_45%)]"></div>

    <div class="hero-wash__boundary absolute left-0 w-full z-20" style="top: 0%;">
      <div class="hero-wash__mist absolute inset-x-0 -top-5 h-10"></div>
      <div class="hero-wash__line absolute inset-x-0 top-0 h-[2px]"></div>
      <span class="hero-wash__drop" style="left:6%; animation-delay:0s;"></span>
      <span class="hero-wash__drop" style="left:18%; animation-delay:0.6s;"></span>
      <span class="hero-wash__drop" style="left:31%; animation-delay:0.2s;"></span>
      <span class="hero-wash__drop" style="left:44%; animation-delay:0.9s;"></span>
      <span class="hero-wash__drop" style="left:57%; animation-delay:0.4s;"></span>
      <span class="hero-wash__drop" style="left:70%; animation-delay:0.1s;"></span>
      <span class="hero-wash__drop" style="left:83%; animation-delay:0.7s;"></span>
      <span class="hero-wash__drop" style="left:94%; animation-delay:0.5s;"></span>
      <img
        class="hero-wash__hose absolute -top-[48px] sm:-top-[69px] lg:-top-[84px] -right-16 sm:-right-24 lg:-right-32 w-[260px] sm:w-[380px] lg:w-[460px] drop-shadow-[0_10px_16px_rgba(0,0,0,0.45)]"
        src="/images/hose.png"
        alt=""
        aria-hidden="true"
      />
    </div>

    <div class="hero-wash__content relative z-10 h-full w-full max-w-[1280px] mx-auto px-7 flex items-center">
      <div class="max-w-[580px] pb-16">
        <div class="hero-wash__reveal inline-flex items-center gap-2 px-4 py-2 mb-5 text-xs font-bold tracking-[0.22em] uppercase border rounded-lg bg-red-600/15 border-red-500/50 text-white" data-reveal-at="0.32">Firefighter Owned &amp; Operated</div>
        <h1 class="hero-wash__reveal mb-5 font-black uppercase leading-[0.9] tracking-tight" data-reveal-at="0.5">
          <span class="block text-[clamp(3rem,6.5vw,5.8rem)] text-red-500">Restore.</span>
          <span class="block text-[clamp(3rem,6.5vw,5.8rem)] text-white">Refresh.</span>
          <span class="block mt-2 text-[clamp(1.5rem,2.8vw,2.5rem)] font-semibold text-neutral-300">Soft Pressure Washing</span>
        </h1>
        <p class="hero-wash__reveal max-w-[440px] mb-9 text-neutral-300 leading-relaxed" data-reveal-at="0.68">
          Residential &amp; commercial soft wash and pressure cleaning: safe, thorough, and built on the same commitment to service we carry on the line. Licensed. Insured. 100% satisfaction guaranteed.
        </p>
        <div class="hero-wash__reveal flex flex-wrap items-center gap-4 mb-12" data-reveal-at="0.86">
          <a href="/estimate" class="inline-flex items-center gap-2 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm bg-red-600 border-red-600 text-white hover:bg-transparent hover:text-red-500 hover:-translate-y-0.5 shadow-lg shadow-red-600/30">
            Get a Free Quote
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M7 7h10v10"></path></svg>
          </a>
          <a href="#services" class="inline-flex items-center gap-2 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm border-white text-white hover:bg-white/15">
            Our Services ›
          </a>
        </div>
        <div class="hero-wash__reveal flex items-center gap-3 text-sm font-semibold text-neutral-300" data-reveal-at="0.98">
          <span>Google Rating 5.0</span>
          <span class="text-red-500 tracking-[2px]">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        </div>
      </div>
    </div>
  </div>

  <div class="sticky z-40" style="top: calc(100vh - 46px);">
    <Marquee />
  </div>
</section>

<style>
  .hero-wash {
    height: 240vh;
  }
  .hero-wash__reveal {
    opacity: 0;
    transform: translateY(18px);
    pointer-events: none;
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .hero-wash__reveal.is-revealed {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .hero-wash__mist {
    background: linear-gradient(to bottom, transparent, rgba(255, 255, 255, 0.55));
    filter: blur(6px);
  }
  .hero-wash__line {
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 0 14px 2px rgba(180, 225, 255, 0.8), 0 0 32px 6px rgba(120, 200, 255, 0.35);
    animation: hero-wash-ripple 1.8s ease-in-out infinite;
  }
  @keyframes hero-wash-ripple {
    0%, 100% { opacity: 0.75; }
    50% { opacity: 1; }
  }
  .hero-wash__drop {
    position: absolute;
    top: -5px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(210, 240, 255, 0.98);
    box-shadow: 0 0 8px 2px rgba(180, 230, 255, 0.9), 0 0 3px rgba(255, 255, 255, 0.9);
    animation: hero-wash-drop 1.3s ease-in infinite;
  }
  @keyframes hero-wash-drop {
    0% { transform: translateY(0) scale(1); opacity: 1; }
    75% { opacity: 0.75; }
    100% { transform: translateY(46px) scale(0.35); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-wash__reveal {
      transition: none;
    }
    .hero-wash__line {
      animation: none;
    }
    .hero-wash__drop {
      display: none;
    }
  }
</style>

<script>
  function initHeroWash() {
    const section = document.querySelector<HTMLElement>(".hero-wash");
    const sticky = document.querySelector<HTMLElement>(".hero-wash__sticky");
    const afterWrap = document.querySelector<HTMLElement>(".hero-wash__after-wrap");
    const boundary = document.querySelector<HTMLElement>(".hero-wash__boundary");
    const revealEls = Array.from(document.querySelectorAll<HTMLElement>(".hero-wash__reveal"));
    if (!section || !sticky || !afterWrap || !boundary || !revealEls.length || section.dataset.init) return;
    section.dataset.init = "true";

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) {
      afterWrap.style.height = "100%";
      boundary.style.top = "100%";
      revealEls.forEach((el) => el.classList.add("is-revealed"));
      return;
    }

    let ticking = false;

    const update = () => {
      ticking = false;
      const rect = section.getBoundingClientRect();
      const total = rect.height - sticky.offsetHeight;
      const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;

      // House reveals from the top down as the visitor scrolls through the hero.
      const revealPct = Math.min(100, Math.max(0, progress * 100));
      afterWrap.style.height = `${revealPct}%`;
      boundary.style.top = `${revealPct}%`;

      // Each piece of hero content fades in once the wash reveal passes its own threshold.
      revealEls.forEach((el) => {
        const threshold = Number(el.dataset.revealAt || "0");
        el.classList.toggle("is-revealed", progress >= threshold);
      });
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  }
  document.addEventListener("DOMContentLoaded", initHeroWash);
  initHeroWash();
</script>
