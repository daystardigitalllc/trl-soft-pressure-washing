---
export interface Props {
  href: string;
  image: string;
  eyebrow: string;
  label: string;
  description: string;
  tag: string;
}
const { href, image, eyebrow, label, description, tag } = Astro.props as Props;
---
<a href={href} class="no-underline reveal">
  <div class="bg-white border border-black/10 shadow-sm overflow-hidden flex flex-col h-full hover:-translate-y-1.5 hover:shadow-2xl transition duration-300 group">
    <div class="relative h-[190px] overflow-hidden bg-neutral-200">
      <img alt={label} class="w-full h-full object-cover transition duration-500 group-hover:scale-105" src={image} loading="lazy" />
      <div class="absolute inset-0 bg-red-600/10 opacity-0 group-hover:opacity-100 transition"></div>
      <div class="absolute top-3 left-3 bg-black/55 text-white text-[0.65rem] uppercase tracking-[0.2em] px-[10px] py-[4px] backdrop-blur">{eyebrow}</div>
    </div>
    <div class="p-6 flex flex-col flex-grow">
      <div class="flex items-start justify-between mb-3">
        <div class="text-neutral-300 group-hover:text-red-600 transition ml-auto">&#8599;</div>
      </div>
      <h3 class="uppercase font-extrabold text-[1.2rem] leading-[1.1] tracking-[0.02em] mb-2 text-black">{label}</h3>
      <p class="text-[0.88rem] text-[#777] leading-[1.6] mb-4 flex-grow">{description}</p>
      <div class="flex items-center gap-2 text-red-600 uppercase text-[0.65rem] tracking-[0.16em] font-bold">
        <span class="w-[14px] h-[1.5px] bg-red-600"></span>
        {tag}
      </div>
    </div>
  </div>
</a>
