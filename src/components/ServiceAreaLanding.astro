---
import Faq from "./Faq.astro";
import { business } from "../data/business.js";

export interface Props {
  city: string;
  state: string;
  heading: string;
  intro: string;
  intro2: string;
  offerings: { title: string; desc: string }[];
  servingTitle: string;
  neighborhoods: string[];
  faqs: { q: string; a: string }[];
}

const { city, state, heading, intro, intro2, offerings, servingTitle, neighborhoods, faqs } = Astro.props as Props;
---
<nav class="max-w-6xl mx-auto px-6 pt-8 text-sm text-neutral-500">
  <a href="/" class="hover:text-red-600">Home</a> <span class="mx-1">/</span> <span class="text-black font-semibold">{city}, {state}</span>
</nav>

<section class="py-14 bg-white">
  <div class="max-w-4xl mx-auto px-6 text-center reveal">
    <span class="text-xs font-bold tracking-[0.2em] uppercase text-red-600">Service Area &ndash; {city}, {state}</span>
    <h1 class="mt-3 text-4xl font-black uppercase leading-tight sm:text-5xl">{heading}</h1>
    <p class="mt-6 text-neutral-600 text-lg leading-relaxed">{intro}</p>
    <p class="mt-4 text-neutral-600 text-lg leading-relaxed">{intro2}</p>
    <a href={business.smsHref} class="inline-flex items-center gap-2 mt-8 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm bg-red-600 border-red-600 text-white hover:bg-transparent hover:text-red-600">
      Get a Free Quote
    </a>
  </div>
</section>

<section class="py-20 bg-neutral-50">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid gap-6 sm:grid-cols-3">
      {offerings.map((o) => (
        <div class="bg-white border border-black/10 border-t-4 border-t-red-600 p-6 reveal">
          <h3 class="font-extrabold uppercase text-base mb-2">{o.title}</h3>
          <p class="text-neutral-500 text-sm leading-relaxed">{o.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="py-20 bg-white">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-2xl font-black uppercase mb-4 reveal">{servingTitle}</h2>
    <p class="text-neutral-600 mb-6 reveal">We provide comprehensive service to the {city} area, including:</p>
    <ul class="space-y-3 reveal">
      {neighborhoods.map((n) => (
        <li class="pl-5 relative text-neutral-600">
          <span class="absolute left-0 top-2 w-2 h-2 bg-red-600"></span>
          {n}
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="py-24 bg-neutral-50">
  <div class="max-w-3xl mx-auto px-6">
    <div class="mb-10 reveal">
      <span class="text-xs font-bold tracking-[0.2em] uppercase text-red-600">Frequently Asked Questions</span>
      <h2 class="mt-3 text-3xl font-black uppercase leading-tight sm:text-4xl">Everything you need to know</h2>
      <p class="mt-4 text-neutral-500 text-lg">About our process and professional standards.</p>
    </div>
    <Faq faqs={faqs} />
  </div>
</section>

<section class="bg-black text-white text-center py-24 px-6">
  <h2 class="text-4xl font-black uppercase sm:text-5xl mb-5">Ready to Restore Your {city} Property?</h2>
  <p class="text-neutral-300 max-w-2xl mx-auto mb-8 text-lg">Licensed, insured, and firefighter owned — proudly serving {city}, {state} and all of Middle Tennessee.</p>
  <div class="flex flex-wrap justify-center gap-4">
    <a href={business.smsHref} class="inline-flex items-center gap-2 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm bg-red-600 border-red-600 text-white hover:bg-transparent">Get a Free Quote</a>
    <a href={business.phoneHref} class="inline-flex items-center gap-2 px-8 py-3.5 font-bold tracking-wider uppercase transition border-2 rounded-sm border-white text-white hover:bg-white hover:text-black">Call {business.phoneDisplay}</a>
  </div>
</section>
