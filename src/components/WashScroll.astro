---
export interface Props {
  before: string;
  after: string;
}
const { before, after } = Astro.props as Props;
---
<section class="wash-scroll relative bg-black" aria-hidden="false">
  <div class="wash-scroll__sticky sticky top-0 h-screen overflow-hidden">
    <img class="wash-scroll__bg absolute inset-0 w-full h-full object-cover" src={before} alt="House before cleaning" />
    <div class="wash-scroll__after-wrap absolute inset-0" style="clip-path: inset(0 100% 0 0);">
      <img class="absolute inset-0 w-full h-full object-cover" src={after} alt="House after cleaning" />
    </div>
    <div class="absolute inset-0 bg-black/35"></div>

    <div class="absolute inset-0 flex items-center justify-center px-6 text-center pointer-events-none">
      <div>
        <span class="text-xs font-bold tracking-[0.3em] uppercase text-red-500">Watch Us Work</span>
        <h2 class="mt-3 text-white font-black uppercase leading-[0.95] text-[clamp(2.2rem,6vw,4.5rem)]">
          Dirty to<br /><span class="text-red-500">Done.</span>
        </h2>
      </div>
    </div>

    <div class="wash-scroll__truck absolute" style="bottom: 8%; left: 0; transform: translateX(-120%);">
      <svg viewBox="0 0 200 100" width="180" height="90" xmlns="http://www.w3.org/2000/svg">
        <rect x="4" y="42" width="120" height="34" rx="4" fill="#cc1111" />
        <rect x="110" y="20" width="46" height="56" rx="4" fill="#cc1111" />
        <rect x="118" y="28" width="30" height="18" rx="2" fill="#0a0a0a" opacity="0.85" />
        <rect x="4" y="30" width="100" height="4" fill="#ffffff" opacity="0.5" />
        <rect x="10" y="50" width="108" height="6" fill="#0a0a0a" opacity="0.25" />
        <circle cx="34" cy="80" r="14" fill="#111111" />
        <circle cx="34" cy="80" r="5" fill="#888888" />
        <circle cx="130" cy="80" r="14" fill="#111111" />
        <circle cx="130" cy="80" r="5" fill="#888888" />
        <rect x="40" y="8" width="4" height="36" fill="#0a0a0a" />
        <rect x="12" y="6" width="60" height="4" fill="#0a0a0a" />
        <circle cx="156" cy="46" r="4" fill="#ffcc00" />
      </svg>
      <svg class="wash-scroll__spray absolute -right-16 top-2" viewBox="0 0 120 60" width="140" height="70" xmlns="http://www.w3.org/2000/svg">
        <path class="wash-scroll__spray-path" d="M0 18 Q 55 -8 115 30" fill="none" stroke="#8fd9ff" stroke-width="3" stroke-linecap="round" stroke-dasharray="4 9" />
        <path class="wash-scroll__spray-path wash-scroll__spray-path--2" d="M0 30 Q 55 10 115 42" fill="none" stroke="#c9ecff" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="3 8" />
      </svg>
    </div>
  </div>
</section>

<style>
  .wash-scroll {
    height: 320vh;
  }
  .wash-scroll__spray-path {
    animation: wash-spray-flow 0.6s linear infinite;
  }
  .wash-scroll__spray-path--2 {
    animation-duration: 0.5s;
  }
  @keyframes wash-spray-flow {
    to {
      stroke-dashoffset: -26;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .wash-scroll__spray-path {
      animation: none;
    }
  }
</style>

<script>
  function initWashScroll() {
    const section = document.querySelector<HTMLElement>(".wash-scroll");
    const truck = document.querySelector<HTMLElement>(".wash-scroll__truck");
    const afterWrap = document.querySelector<HTMLElement>(".wash-scroll__after-wrap");
    if (!section || !truck || !afterWrap || section.dataset.init) return;
    section.dataset.init = "true";

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduceMotion) {
      truck.style.transform = "translateX(600%)";
      afterWrap.style.clipPath = "inset(0 0% 0 0)";
      return;
    }

    let ticking = false;

    const update = () => {
      ticking = false;
      const rect = section.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 0;

      // Truck travels from off-screen left to off-screen right across the visible stage.
      const truckPct = -20 + progress * 140;
      truck.style.transform = `translateX(${truckPct}vw)`;

      // House reveal trails slightly behind the truck's nozzle.
      const revealPct = Math.min(100, Math.max(0, (progress - 0.05) / 0.9 * 100));
      afterWrap.style.clipPath = `inset(0 ${100 - revealPct}% 0 0)`;
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  }
  document.addEventListener("DOMContentLoaded", initWashScroll);
  initWashScroll();
</script>
