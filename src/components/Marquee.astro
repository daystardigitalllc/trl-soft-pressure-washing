---
export interface Props {
  items?: string[];
}
const {
  items = [
    "24/7 Emergency Response",
    "Soft Wash Specialists",
    "The Thin Red Line",
    "Residential & Commercial",
    "Firefighter Owned & Operated",
    "Licensed & Insured",
    "Satisfaction Guaranteed",
  ],
} = Astro.props as Props;
---
<div class="bg-black overflow-hidden border-y border-white/10" role="presentation" aria-hidden="true">
  <div class="marquee-track py-3.5">
    {[...items, ...items].map((item) => (
      <span class="flex items-center gap-6 px-8 text-xs tracking-[0.22em] uppercase text-slate-50 font-bold whitespace-nowrap">
        {item}
        <span class="text-red-600">&#9733;</span>
      </span>
    ))}
  </div>
</div>
